# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.stringfintech.com

# Contact form delivery: configure ONE of the options below.
# Option A: email via Resend (https://resend.com); the sender domain must be verified there.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=String FinTech Website <website@stringfintech.com>
ENQUIRY_TO_EMAIL=info@stringfintech.com

# Option B: POST each enquiry as JSON to a webhook (CRM, Zapier, Make, Slack workflow…)
ENQUIRY_WEBHOOK_URL=
